# Apache (бештари хостингҳо бо cPanel). Барои nginx ба README.md нигаред.

DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# Файлҳои хизматӣ аз берун кушода намешаванд
<FilesMatch "(?i)\.(sql|md|yml|yaml|log|ini|dist|example|lock)$|^(Dockerfile|\.gitignore|\.git.*)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /storage(/|$)

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
